{
  "name": "afterscene",
  "version": "0.1.0",
  "private": true,
  "description": "afterscene — the conversation starts after the credits.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "seed": "tsx --conditions=react-server scripts/seed.ts",
    "brand:generate": "tsx scripts/generate-brand-assets.ts",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "db:reset": "supabase db reset",
    "db:gen-types": "tsx scripts/gen-db-types.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "fast-xml-parser": "^5.11.1",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.545.0",
    "next": "15.5.26",
    "next-intl": "^4.14.7",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.2.1",
    "resend": "^6.30.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^20.19.0",
    "@types/opentype.js": "^1.3.10",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.37.0",
    "eslint-config-next": "15.5.26",
    "opentype.js": "^2.0.0",
    "supabase": "^2.51.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
